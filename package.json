{
  "name": "codestory-view",
  "displayName": "Codestory View",
  "publisher": "codestorybuild",
  "description": "Visualizer for Codestory CLI",
  "license": "GPL-2.0-only",
  "version": "0.0.1",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeStoryBuild/CodeStoryView.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codestory-view.start"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "resources/**",
    "README.md",
    "LICENCE.txt",
    "CHANGELOG.md",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codestory-view.start",
        "title": "Start Codestory View"
      }
    ],
    "configuration": {
      "title": "Codestory Visualizer",
      "properties": {
        "codestoryView.branchUpdateStrategy": {
          "type": "string",
          "enum": [
            "prompt",
            "update",
            "ignore"
          ],
          "default": "prompt",
          "markdownDescription": "Strategy for updating the branch when a new branch is detected in the repository."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package:all",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "package:all": "npm run build:webview && npm run package",
    "build:webview": "npm --prefix webview-ui run build:dist",
    "build:all": "npm run build:webview && npm run compile",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.10.0",
    "@types/semver": "^7.7.1",
    "@types/tar": "^6.1.13",
    "@types/vscode": "^1.90.0",
    "eslint": "^8.41.0",
    "glob": "^10.3.0",
    "mocha": "^10.2.0",
    "prettier": "^3.7.4",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.50.0",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "semver": "^7.7.3",
    "tar": "^7.5.2"
  }
}